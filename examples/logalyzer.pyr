import sys
import os
import time
import json
import math
import statistics
from dataclasses import dataclass


@dataclass
class LogRecord:
    ip: str = "0.0.0.0"
    method: str = "GET"
    path: str = "/"
    status: int = 200
    size: int = 0
    agent: str = "curl"


DEFAULT_COUNT = 100000


def pick_method(i):
    m = i % 6
    if m == 0:
        return "POST"
    elif m == 1:
        return "PUT"
    elif m == 2:
        return "DELETE"
    else:
        return "GET"


def pick_path(i):
    p = i % 6
    if p == 0:
        return "/"
    elif p == 1:
        return "/index"
    elif p == 2:
        return "/api/users"
    elif p == 3:
        return "/api/orders"
    elif p == 4:
        return "/login"
    else:
        return "/static/app.js"


def pick_agent(i):
    a = i % 4
    if a == 0:
        return "curl"
    elif a == 1:
        return "Mozilla"
    elif a == 2:
        return "python-requests"
    else:
        return "Go-http"


def make_ip(i):
    a = (i * 37 + 11) % 256
    b = (i * 91 + 7) % 256
    c = (i * 13 + 5) % 256
    d = (i * 7 + 1) % 256
    return "%d.%d.%d.%d" % (a, b, c, d)


def make_status(i):
    r = i % 20
    if r == 0:
        return 500
    elif r == 1:
        return 404
    elif r == 2:
        return 301
    else:
        return 200


def make_size(i):
    base = (i * 137) % 5000
    return base + 100 + (i % 7)


def write_log(path, n=DEFAULT_COUNT):
    f = open(path, "w")
    i = 0
    while i < n:
        line = "{} {} {} {} {} {}".format(
            make_ip(i), pick_method(i), pick_path(i),
            make_status(i), make_size(i), pick_agent(i),
        )
        f.write(line + "\n")
        i = i + 1
    f.close()
    return n


class Analyzer:
    def __init__(self):
        self.total = 0
        self.bytes_sent = 0
        self.errors = 0
        self.ok = 0
        self.by_status = {}
        self.by_path = {}

    def add(self, rec):
        self.total = self.total + 1
        self.bytes_sent = self.bytes_sent + rec.size
        code = rec.status
        hits = self.by_status.get(code, 0)
        self.by_status[code] = hits + 1
        seen = self.by_path.get(rec.path, 0)
        self.by_path[rec.path] = seen + 1
        if code >= 500:
            self.errors = self.errors + 1
        else:
            self.ok = self.ok + 1

    def error_rate(self):
        if self.total == 0:
            return 0.0
        return self.errors / self.total

    def report(self):
        lines = []
        lines.append("total=%d bytes=%d errors=%d" % (self.total, self.bytes_sent, self.errors))
        lines.append("error_rate=%.3f ok=%d" % (self.error_rate(), self.ok))
        return "\n".join(lines)


class ExtendedAnalyzer(Analyzer):
    def __init__(self):
        self.total = 0
        self.bytes_sent = 0
        self.errors = 0
        self.ok = 0
        self.by_status = {}
        self.by_path = {}
        self.big = 0
        self.note = "extended"

    def add_big(self, rec):
        self.add(rec)
        if rec.size > 1000:
            self.big = self.big + 1

    def big_share(self):
        if self.total == 0:
            return 0.0
        return self.big / self.total


def parse_line(line):
    parts = line.split()
    if len(parts) != 6:
        return LogRecord("?", "?", "?", 0, 0, "?")
    code = int(parts[3])
    size = int(parts[4])
    if not (0 <= code < 600):
        return LogRecord("?", "?", "?", 0, 0, "?")
    return LogRecord(parts[0], parts[1], parts[2], code, size, parts[5])


def top_paths(by_path, k):
    pairs = []
    for p in by_path.keys():
        pairs.append((by_path[p], p))
    pairs = sorted(pairs)
    if k > len(pairs):
        k = len(pairs)
    top = pairs[len(pairs) - k:]
    top.reverse()
    return top


def analyze(path):
    an = ExtendedAnalyzer()
    recs = []
    with open(path) as f:
        for line in f:
            if not line.strip():
                continue
            rec = parse_line(line)
            if rec.status == 0:
                continue
            an.add_big(rec)
            recs.append(rec)
    return an, recs


def total_all(*nums):
    s = 0
    for n in nums:
        s = s + n
    return s


def check_ratio(a, b):
    if b == 0:
        return "n/a"
    r = a / b
    if r > 1.0:
        return "hot"
    elif r == 1.0:
        return "even"
    else:
        return "cool"


def main(args):
    n = DEFAULT_COUNT
    if len(args) > 1:
        n = int(args[1])
    path = "bench_log.txt"
    t0 = time.time()
    wrote = write_log(path, n)
    t1 = time.time()
    assert wrote == n, "short write"
    an, recs = analyze(path)
    t2 = time.time()
    assert an.total == n, "count mismatch"
    print(an.report())
    print("note=%s ok=%d" % (an.note, an.ok))
    top = top_paths(an.by_path, 3)
    print("top paths:")
    for count, p in top:
        print("  %s: %d" % (p, count))
    print("big responses: %d (share=%.2f)" % (an.big, an.big_share()))
    total2 = sum([r.size for r in recs])
    assert total2 == an.bytes_sent, "sum mismatch"
    biggest = max([r.size for r in recs])
    smallest = min([r.size for r in recs])
    print("size range: %d..%d" % (smallest, biggest))
    fsizes = [float(r.size) for r in recs]
    m1 = total2 / len(recs)
    m2 = statistics.mean(fsizes)
    assert abs(m1 - m2) < 0.01, "mean mismatch"
    print("mean size: %.2f" % m1)
    rms = math.sqrt(sum([float(r.size) * float(r.size) for r in recs]) / len(recs))
    print("rms: %.2f pi=%s" % (rms, str(math.pi)[:4]))
    summary = {"total": an.total, "errors": an.errors, "missing": None}
    text = json.dumps(summary)
    print(text)
    out = open("report.json", "w")
    out.write(text + "\n")
    out.close()
    back = open("report.json")
    raw = back.read()
    back.close()
    print("roundtrip bytes: %d" % len(raw))
    data = json.loads(raw)
    print(data)
    print("total check: %s" % str(data.get("total") == an.total))
    print("missing is none: %s" % str(data.get("nope") is None))
    print("gen=%.3fs analyze=%.3fs" % (t1 - t0, t2 - t1))
    avg = an.bytes_sent // an.total if an.total > 0 else 0
    print("avg bytes: %d" % avg)
    print("any errors: %s" % ("yes" if an.errors > 0 else "no"))
    print("mult/div check: %d %d" % (an.total // 7, an.total % 7))
    print("neg check: %d %d" % (-7 % 3, -7 // 3))
    print("pow check: %d %.1f" % (2 ** 10, 2 ** -1))
    print("tuple check: %s" % str((1, "a")))
    q, r = divmod(an.total, 1000)
    print("divmod: %d %d" % (q, r))
    print("round bankers: %d %d" % (round(2.5), round(3.5)))
    print("hex/oct/bin: %s %s %s" % (hex(255), oct(8), bin(5)))
    print("ord/chr: %d %s" % (ord("A"), chr(65)))
    print("all/any: %s %s" % (str(all([True, an.total > 0])), str(any([False, an.errors > 1000000]))))
    probe = -1
    for v in [7, 8]:
        probe = v
        break
    else:
        probe = -2
    assert probe == 7, "break-taken else ran"
    print("break-taken ok")
    left = 3
    while left > 0:
        left = left - 1
    else:
        print("while-else ok")
    xs = [1, 2, 3, 4]
    print("slice: %s last=%d" % (str(xs[1:3]), xs[-1]))
    print("stepped: %s" % str(list(range(0, 10, 2))))
    print("sorted str: %s" % str(sorted("cba")))
    print("joined: %s" % ", ".join(["a", "b"]))
    print("stripped: '%s' upper=%s" % ("  padded  ".strip(), "abc".upper()))
    print("find/count: %d %d" % ("hello".find("ll"), "a,b,a".count("a")))
    print("starts/ends: %s %s" % (str("abc".startswith("a")), str("abc".endswith("c"))))
    a = b = 0
    a = a + 1
    b = b + 2
    x = 1
    y = 2
    x, y = y, x
    print("swap check: %d %d %d %d" % (a, b, x, y))
    d2 = {"k": 1}
    d2["k"] += 5
    print("aug subscript: %d" % d2["k"])
    d2["new"] = 7
    print("after set: %d keys" % len(d2))
    del d2["new"]
    print("after del: %d keys" % len(d2))
    tl = [3, 1, 2]
    tl.append(0)
    tl.sort()
    print("sorted list: %s" % str(tl))
    tl.remove(0)
    print("after remove: %s idx=%d count=%d" % (str(tl), tl.index(3), tl.count(3)))
    en = list(enumerate(["a", "b"], 1))
    print("enumerate: %s" % str(en))
    zp = list(zip([1, 2], ["a", "b"]))
    print("zip: %s" % str(zp))
    print("rev: %s" % str(list(reversed([1, 2, 3]))))
    print("range-neg: %s" % str(list(range(5, 0, -1))))
    print("in-checks: %s %s %s" % (str(2 in (1, 2)), str("k" in d2), str(99 not in [1])))
    print("bool arith: %d" % (True + 1))
    v = d2.get("zzz")
    print("missing get: %s" % str(v is None))
    sq = {i: i * i for i in range(5)}
    print("dictcomp: %d" % sq[4])
    uq = {w[0] for w in ["ab", "ac", "b"]}
    print("setcomp: %s" % str(sorted(uq)))
    print("splat call: %d" % total_all(1, 2, 3, 4))
    print("fstr: %s=%d" % ("n", n))
    print(f"direct total={an.total}")
    print("upper const test: %s" % str(DEFAULT_COUNT > 0))
    x = 10
    x += 5
    x -= 2
    x *= 2
    x //= 3
    x %= 4
    x **= 2
    print("aug chain: %d" % x)
    print("bitwise: %d %d %d %d %d" % (6 & 3, 6 | 3, 6 ^ 3, 1 << 4, 256 >> 4))
    print("chained: %s" % str(0 <= an.total))
    if (m := len(top)) > 0:
        print("have %d top entries" % m)
    if not an.by_status:
        print("unreachable")
    print("py version: %s impl: %s" % ("3.11", "pyrust"))
    print("done rc=0")
    sys.exit(0)


main(sys.argv)
